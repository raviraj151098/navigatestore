{
  "components/common/quick-search": "<div class=\"container\">\n    <form class=\"form\" data-url=\"{{urls.search}}\" data-quick-search-form>\n        <fieldset class=\"form-fieldset\">\n            <div class=\"form-field\">\n                {{#if semantic_search_enabled}}\n                <label class=\"is-srOnly\" for=\"{{name}}\">{{lang \"search.quick_search.input_label_semantic\"}}</label>\n                {{else}}\n                <label class=\"is-srOnly\" for=\"{{name}}\">{{lang \"search.quick_search.input_label\"}}</label>\n                {{/if}}\n                <input class=\"form-input\"\n                       data-search-quick\n                       name=\"{{name}}\"\n                       id=\"{{name}}\"\n                       data-error-message=\"{{lang 'search.error.empty_field'}}\"\n                       {{#if semantic_search_enabled}}\n                       placeholder=\"{{lang 'search.quick_search.input_placeholder_semantic'}}\"\n                       {{else}}\n                       placeholder=\"{{lang 'search.quick_search.input_placeholder'}}\"\n                       {{/if}}\n                       autocomplete=\"off\"\n                >\n            </div>\n        </fieldset>\n    </form>\n    <section class=\"quickSearchResults\" data-bind=\"html: results\"></section>\n    <p role=\"status\"\n       aria-live=\"polite\"\n       class=\"aria-description--hidden\"\n       data-search-aria-message-predefined-text=\"{{{lang 'search.results.quick_count_live'}}}\"\n    ></p>\n</div>\n"
}